@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Mei Tao
+ *
+ * Lens shading helpers for software ISP statistics
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <stdint.h>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+namespace libcamera {
+
+struct LscStatsGains {
+	uint16_t red;
+	uint16_t green0;
+	uint16_t green1;
+	uint16_t blue;
+};
+
+/* Match GL_LINEAR, GL_CLAMP_TO_EDGE and RGBA8 * 4.0, quantized to Q10. */
+inline uint16_t sampleLscStatsGain(const DebayerParams::LscLookupTable &lut,
+				   double coordX, double coordY, unsigned int channel)
+{
+	constexpr unsigned int size = DebayerParams::kLscGridSize;
+	coordX = std::clamp(coordX * size - 0.5, 0.0, double(size - 1));
+	coordY = std::clamp(coordY * size - 0.5, 0.0, double(size - 1));
+	const unsigned int left = coordX;
+	const unsigned int top = coordY;
+	const unsigned int right = std::min(left + 1, size - 1);
+	const unsigned int bottom = std::min(top + 1, size - 1);
+	const double fractionX = coordX - left;
+	const double fractionY = coordY - top;
+	auto value = [&](unsigned int column, unsigned int row) {
+		return lut[(row * size + column) * DebayerParams::kLscValuesPerCell + channel];
+	};
+	const double upper = value(left, top) * (1.0 - fractionX) + value(right, top) * fractionX;
+	const double lower = value(left, bottom) * (1.0 - fractionX) + value(right, bottom) * fractionX;
+	const double filtered = upper * (1.0 - fractionY) + lower * fractionY;
+
+	/* UNORM8 divides by 255, not 256: a table byte of 64 is 256/255. */
+	return std::lround(filtered * (4.0 * 1024.0 / 255.0));
+}
+
+inline uint16_t applyLscStatsGain(uint16_t value, uint16_t gain,
+				  uint16_t black, uint16_t maximum)
+{
+	/* Keep the pedestal for the IPA's existing AWB/AGC black subtraction. */
+	const int32_t signal = int32_t(value) - black;
+	const int32_t corrected = black + ((signal * gain + 512) >> 10);
+	return std::clamp(corrected, 0, int32_t(maximum));
+}
+
+} /* namespace libcamera */
